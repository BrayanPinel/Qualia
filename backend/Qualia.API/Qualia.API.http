###############################################################################
# DISPUTAS (Norte tiene plan Pro con disputas; Sur, Básico sin disputas)
# Antes: la supervisora evalúa y confirma la llamada 1 (pasos 2–5 de ROL D y la confirmación de ROL B).
# Copie el id de la evaluación en @evaluacionId.
###############################################################################
@evaluacionId = reemplazar-con-id-de-GET-api-llamadas-llamada1-evaluacion

### 201 El agente propietario (Andrés) disputa su evaluación oficial
# @name crearDisputa
POST {{host}}/api/empresas/{{empresaNorte}}/evaluaciones/{{evaluacionId}}/disputas
X-Usuario-Demo: {{agenteAndres}}
Content-Type: application/json

{
  "motivo": "No estoy de acuerdo: sí verifiqué la identidad del cliente al inicio."
}

### 200 Disputas visibles (Admin: todas; Supervisor: sus campañas; Agente: las suyas)
GET {{host}}/api/empresas/{{empresaNorte}}/disputas?estado=Abierta
X-Usuario-Demo: {{supervisora}}

### 200 Resolver manteniendo las notas (revisionEsperada = revisión actual de la evaluación)
PUT {{host}}/api/empresas/{{empresaNorte}}/disputas/{{crearDisputa.response.body.$.id}}/resolucion
X-Usuario-Demo: {{supervisora}}
Content-Type: application/json

{
  "decision": "Mantener",
  "resolucion": "Se revisó el audio completo y la evaluación se ajusta a la evidencia.",
  "revisionEsperada": 2
}

### 409 DISPUTA_YA_RESUELTA (repetir la resolución)
PUT {{host}}/api/empresas/{{empresaNorte}}/disputas/{{crearDisputa.response.body.$.id}}/resolucion
X-Usuario-Demo: {{supervisora}}
Content-Type: application/json

{
  "decision": "Mantener",
  "resolucion": "Se revisó el audio completo y la evaluación se ajusta a la evidencia.",
  "revisionEsperada": 3
}

### 403 CAMPANA_NO_ASIGNADA (supervisor sin la campaña)
PUT {{host}}/api/empresas/{{empresaNorte}}/disputas/{{crearDisputa.response.body.$.id}}/resolucion
X-Usuario-Demo: {{supervisorSinCampana}}
Content-Type: application/json

{
  "decision": "Mantener",
  "resolucion": "Intento de resolver sin estar asignado a la campaña.",
  "revisionEsperada": 2
}

###############################################################################
# DESEMPEÑO — SCORECARDS Y REPORTES
# Cuentan las evaluaciones oficiales (IA sin fallas, confirmadas o ajustadas) sin disputa abierta.
# periodo = YYYY-MM (por defecto, el mes en curso). Mínimo de muestra: Empresa.minimo_muestra (5).
###############################################################################

### D1. Scorecard propio del agente
GET {{host}}/api/empresas/{{empresaNorte}}/agentes/me/scorecard?campanaId={{campanaNorte}}
X-Usuario-Demo: {{agenteAndres}}

### D2. Scorecard de un agente (AdminEmpresa o Supervisor asignado)
GET {{host}}/api/empresas/{{empresaNorte}}/agentes/{{agenteAndres}}/scorecard?campanaId={{campanaNorte}}
X-Usuario-Demo: {{supervisora}}

### D3. Scorecards del equipo de la campaña (paginados por agente)
GET {{host}}/api/empresas/{{empresaNorte}}/campanas/{{campanaNorte}}/scorecards?pagina=1&tamanoPagina=20
X-Usuario-Demo: {{supervisora}}

### D4. Reporte agregado de la campaña (también para el Auditor)
GET {{host}}/api/empresas/{{empresaNorte}}/reportes/campanas/{{campanaNorte}}
X-Usuario-Demo: {{auditor}}

### D5. 403 CAMPANA_NO_ASIGNADA (supervisor sin la campaña)
GET {{host}}/api/empresas/{{empresaNorte}}/campanas/{{campanaNorte}}/scorecards
X-Usuario-Demo: {{supervisorSinCampana}}

### D6. 404 Aislamiento: la campaña de Sur no existe para Norte
GET {{host}}/api/empresas/{{empresaNorte}}/reportes/campanas/{{campanaSur}}
X-Usuario-Demo: {{adminNorte}}

### D7. 400 VALIDACION (periodo con formato inválido)
GET {{host}}/api/empresas/{{empresaNorte}}/reportes/campanas/{{campanaNorte}}?periodo=2026-13
X-Usuario-Demo: {{adminNorte}}

###############################################################################
# EMPRESA EN LA RUTA: el {empresaId} de la URL debe ser el de la sesión
###############################################################################

### 404 EMPRESA_NO_ENCONTRADA (Ana es de Norte y pide los usuarios de Sur)
GET {{host}}/api/empresas/{{empresaSur}}/usuarios
Authorization: Bearer {{tokenAdminNorte}}

### 403 ROL_NO_AUTORIZADO (PlatformAdmin no tiene empresa: no entra a rutas de empresa)
GET {{host}}/api/empresas/{{empresaNorte}}/llamadas
Authorization: Bearer {{tokenPlatformAdmin}}
