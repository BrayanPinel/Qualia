  "codigoEmpresa": "demo-norte",
  "email": "ana.admin@norte.demo",
  "password": "Qualia-Demo-2026"
}

### Usar el token: campañas de Norte con Authorization Bearer
GET {{host}}/api/empresas/{{empresaNorte}}/campanas
Authorization: Bearer {{tokenAdminNorte}}

### 200 Login de plataforma (PlatformAdmin, sin empresa)
# @name loginPlataforma
POST {{host}}/api/plataforma/auth/login
Content-Type: application/json

{
  "email": "admin@qualia.demo",
  "password": "Qualia-Demo-2026"
}

### 403 PlatformAdmin no accede al contenido de las empresas
GET {{host}}/api/empresas/{{empresaNorte}}/llamadas
Authorization: Bearer {{tokenPlatformAdmin}}

### 401 CREDENCIALES_INVALIDAS (mismo mensaje para empresa, correo o contraseña incorrectos)
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "codigoEmpresa": "demo-norte",
  "email": "ana.admin@norte.demo",
  "password": "Contrasena-Equivocada"
}

### 401 NO_AUTENTICADO (sin token)
GET {{host}}/api/empresas/{{empresaNorte}}/campanas

### 401 TOKEN_INVALIDO (token alterado)
GET {{host}}/api/empresas/{{empresaNorte}}/campanas
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.e30.firma-invalida

###############################################################################
# USUARIOS (solo AdminEmpresa). Ejecute antes "Login empresarial" (@name loginNorte).
###############################################################################

