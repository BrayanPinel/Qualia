# backend/Qualia.API/.env  (copiar este archivo como backend/Qualia.API/.env)
# Username, Password y Database deben coincidir con infra/.env
ConnectionStrings__PostgresConnection="Host=localhost;Port=5432;Database=QualiaDB;Username=qualia;Password="

# Secreto HMAC para firmar las URLs temporales de audio (mínimo 32 caracteres)
Audio__ClaveFirma=""

# Proveedores de IA para IA:Modo=Real (si faltan, la API usa el modo Simulado)
Deepgram__ApiKey=""
Groq__ApiKey=""

# Clave para firmar los JWT (mínimo 32 caracteres, aleatoria). Si falta, en Development se usa
# una clave temporal y los tokens dejan de valer al reiniciar; en otros entornos la API no arranca.
Jwt__Key=""

# Orígenes del frontend permitidos por CORS, separados por comas (sin barra final).
# En Development, si falta, se permite http://localhost:5173.
CORS_ALLOWED_ORIGINS="http://localhost:5173"
