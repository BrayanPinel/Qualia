# backend/Qualia.API/.env  (copiar este archivo como backend/Qualia.API/.env)
# Username, Password y Database deben coincidir con infra/.env
ConnectionStrings__PostgresConnection="Host=localhost;Port=5432;Database=QualiaDB;Username=qualia;Password="

# Secreto HMAC para firmar las URLs temporales de audio (mínimo 32 caracteres)
Audio__ClaveFirma=""

# Proveedores de IA para IA:Modo=Real (si faltan, la API usa el modo Simulado)
Deepgram__ApiKey=""
Groq__ApiKey=""
